{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "noEmit": false,
    "noUnusedLocals": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "tests", "dist"]
}
